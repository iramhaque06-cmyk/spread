# Generated artifacts and caches (per SPEC / plan)
spread.db
cache/
__pycache__/
*.pyc

# The exported site data. Regenerated by `catalog.py` + `export.py` on every
# run, so it is an output of the pipeline rather than source - the same reason
# spread.db is here. Scratch databases and probes from a bounded test run are
# not source either.
data/
*.db
run_all.log
prices*.log

# Raw API responses saved by `spread.py --dump-raw` (evidence, not source)
raw_samples/

# Local environment: API keys live here and must never be committed.
# ODDS_API_KEY is read from the environment by the sportsbook adapter.
.env
*.key

# Freebuff workspace metadata (not part of the prototype)
.freebuff/
